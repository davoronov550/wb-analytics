# =============================================================================
# WB Analytics backend — example environment.
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# =============================================================================

# --- Django core ---
DJANGO_SECRET_KEY=dev-insecure-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL 16) ---
# The application connects as the least-privilege role `wb_app` (created by
# db/init/01-app-role.sql), NOT as the superuser. `wbapp` is a local dev
# placeholder — production must use a real secret.
DATABASE_URL=postgres://wb_app:wbapp@localhost:5432/wb_analytics
# Reuse DB connections across requests (seconds; 0 = reconnect every request).
DB_CONN_MAX_AGE=60
# TLS to PostgreSQL: disable | require | verify-ca | verify-full.
# Local container: disable. Production: verify-full.
DB_SSLMODE=disable
# Used only by docker-compose.yml to bootstrap the container (superuser):
POSTGRES_DB=wb_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Redis / Celery (async + scheduled work) ---
# Password must match REDIS_PASSWORD below (it is embedded in the URL).
REDIS_URL=redis://:devredis@localhost:6379/0
REDIS_PORT=6379
# Redis requires this password (docker-compose passes it to redis-server).
REDIS_PASSWORD=devredis
# Run tasks synchronously (no worker) — handy for tests/local; set by tests.
CELERY_TASK_ALWAYS_EAGER=false

# --- Wildberries gateway (resilience) ---
WB_MAX_PAGES=10
WB_DEST=-1257786
WB_REQUEST_TIMEOUT=10
# Comma-separated proxy URLs for rotation; leave empty to disable.
WB_PROXIES=

# --- Cross-context event bus (seam): inprocess | bus ---
EVENT_PUBLISHER=inprocess

# --- Price-history retention, days ---
SNAPSHOT_RETENTION_DAYS=90

# --- Notifications ---
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
SMTP_USE_TLS=true
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# --- Auth ---
# Signing key for JWT (djangorestframework-simplejwt); falls back to DJANGO_SECRET_KEY if empty.
JWT_SIGNING_KEY=
# Google OAuth 2.0 Web client ID (…apps.googleusercontent.com); required to verify
# Google ID tokens server-side ("Continue with Google"). Public value.
GOOGLE_CLIENT_ID=

# --- CORS (frontend dev origin; comma-separated) ---
CORS_ORIGIN=http://localhost:5173
