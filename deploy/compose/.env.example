# Шаблон локальной конфигурации dev-окружения.
#
#   cp deploy/compose/.env.example deploy/compose/.env
#
# Файл .env не коммитится (.gitignore). Все переменные ниже имеют разумные
# значения по умолчанию прямо в docker-compose.yml, поэтому окружение
# поднимается и без .env — он нужен, только если надо что-то переопределить.
#
# ВСЕ ПАРОЛИ ЗДЕСЬ — ЛОКАЛЬНЫЕ ЗАГЛУШКИ. В продакшене секреты приходят из
# Vault через External Secrets Operator, а не из файлов.

# --- PostgreSQL -------------------------------------------------------------
# Порт смещён с 5432: до вывода Django из контура (фаза 5) старое окружение
# backend/docker-compose.yml работает параллельно и занимает стандартный порт.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=15432

# Роль приложения. Её создаёт init/postgres/01-databases.sh вместе с шестью
# базами: wb_catalog, wb_ingestion, wb_identity, wb_scheduling,
# wb_notifications, wb_export.
APP_DB_USER=wb_app
APP_DB_PASSWORD=wbapp

# --- Kafka 4.x (KRaft) ------------------------------------------------------
KAFKA_VERSION=4.0.0
KAFKA_PORT=29092
# Идентификатор кластера. Фиксирован, чтобы пересоздание тома не требовало
# заново форматировать хранилище метаданных.
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# --- Schema Registry --------------------------------------------------------
SCHEMA_REGISTRY_VERSION=7.8.0
SCHEMA_REGISTRY_PORT=8081

# --- ClickHouse -------------------------------------------------------------
# Нативный порт ClickHouse (9000) совпадает с портом MinIO, поэтому на хосте
# он вынесен на 9100.
CLICKHOUSE_VERSION=24.8-alpine
CLICKHOUSE_DB=wb_analytics
CLICKHOUSE_USER=wb_app
CLICKHOUSE_PASSWORD=wbapp
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9100

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=devredis
REDIS_PORT=16379

# --- MinIO ------------------------------------------------------------------
MINIO_VERSION=RELEASE.2024-11-07T00-52-20Z
MC_VERSION=RELEASE.2024-11-05T11-29-45Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
EXPORT_BUCKET=wb-exports
