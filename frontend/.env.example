# Copy to `.env`. VITE_-prefixed vars are embedded in the client bundle (public).

# Backend API origin.
VITE_API_BASE=http://localhost:8000

# Google OAuth 2.0 Web client ID (…apps.googleusercontent.com).
# Public by design — only the ID is needed for Google Identity Services;
# the client secret is NOT required for ID-token verification.
VITE_GOOGLE_CLIENT_ID=
